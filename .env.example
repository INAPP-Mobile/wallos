# Wallos on Railway — example environment
#
# The one-click deploy form is empty: Wallos needs no variables to
# deploy. Everything below is baked into the wrapper image; the rows
# document the values the wrapper sets and the knobs you can override
# as custom service variables after deploy. Never commit a real
# secret here — this file is documentation only.
#
# Container timezone (wrapper bakes UTC; Wallos also has a per-user
# timezone setting in its admin UI).
# TZ=UTC
#
# Optional OIDC single sign-on (upstream env vars; all unset by
# default, password login stays enabled unless you turn it off):
# OIDC_ENABLED=false
# OIDC_PROVIDER_NAME=
# OIDC_CLIENT_ID=wallos
# OIDC_CLIENT_SECRET=your-oidc-client-secret
# OIDC_ISSUER=
# OIDC_AUTH_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_REDIRECT_URL=https://your-domain/index.php
# OIDC_LOGOUT_URL=
# OIDC_USER_IDENTIFIER=sub
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_CREATE_USER=true
# OIDC_DISABLE_PASSWORD_LOGIN=false
# OIDC_REQUIRE_EMAIL_VERIFIED=true
#
# Optional SSRF allowlist (overrides the Security Settings allowlist
# in the Admin UI):
# SSRF_ALLOWLIST=
#
# Port the app listens on (Railway injects this; the wrapper remaps
# nginx to it on every boot).
# PORT=8080
